# Optional keyed providers. Configure only the services you intend to use.
EXA_API_KEY=
PARALLEL_API_KEY=
PARALLEL_SEARCH_MODE=fast
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# Set this instead of FIRECRAWL_API_KEY for a self-hosted Firecrawl instance.
FIRECRAWL_API_URL=

# SearXNG is search-only and must point to an existing instance.
SEARXNG_URL=http://127.0.0.1:8080
